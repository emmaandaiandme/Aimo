{
  "cleanUrls": true,
  "trailingSlash": false,

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],

  "redirects": [
    {
      "source": "/server.js",
      "destination": "https://discord.gg/2ntPVF28bF",
      "permanent": false
    },
    {
      "source": "/script.js",
      "destination": "https://discord.gg/2ntPVF28bF",
      "permanent": false
    },
    {
      "source": "/config.js",
      "destination": "https://discord.gg/2ntPVF28bF",
      "permanent": false
    },
    {
      "source": "/:file*.css",
      "destination": "https://discord.gg/2ntPVF28bF",
      "permanent": false
    }
  ],

  "rewrites": [
    { "source": "/index", "destination": "/index.html" },
    { "source": "/commands", "destination": "/commands.html" },
    { "source": "/premium", "destination": "/premium.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/updates", "destination": "/updates.html" },
    { "source": "/discord", "destination": "/discord.html" },
    { "source": "/invite", "destination": "/invite.html" },
    { "source": "/vote", "destination": "/vote.html" }
  ]
}
